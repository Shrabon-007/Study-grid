PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/academicradar
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:53350,http://localhost:53350
# Optional: Google Gemini API key from https://aistudio.google.com/apikey
# If left blank, the system uses the local smart heuristic engine.
GEMINI_API_KEY=
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Optional Hugging Face token from https://huggingface.co/settings/tokens
# Hugging Face is preferred for grounded coaching/chat when configured.
